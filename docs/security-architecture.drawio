<mxfile host="Electron">
  <diagram name="Security Architecture" id="bionicpro-security">
    <mxGraphModel dx="4564" dy="2689" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="boundary" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;arcSize=6;fillColor=none;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacing=10;fontSize=14;fontStyle=1" value="BionicPRO [Software System]" vertex="1">
          <mxGeometry height="1040" width="1630" x="450" y="65" as="geometry" />
        </mxCell>
        <mxCell id="person" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6C6477;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=12" value="&lt;b&gt;Пользователь (пилот протеза)&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;font color=&quot;#cccccc&quot;&gt;Входит в систему, запрашивает отчёты. Браузер не получает токены IdP.&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="220" x="10" y="492.5" as="geometry" />
        </mxCell>
        <mxCell id="gateway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D7A3E;strokeColor=#0A5C2F;fontColor=#ffffff;fontSize=12" value="&lt;b&gt;nginx-gateway&lt;/b&gt;&lt;br&gt;[Container: nginx]&lt;br&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;Единый origin для браузера:&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;/ → SPA-статика,&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;/auth/* → bionicpro-auth,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;&amp;nbsp;/reports → bionicpro-api через auth_request (валидация сессии + инжекция Bearer).&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;Cookie first-party, CORS не нужен.&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="185" width="280" x="530" y="460" as="geometry" />
        </mxCell>
        <mxCell id="frontend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=12" value="&lt;b&gt;Фронтенд отчётов&lt;/b&gt;&lt;br&gt;[Container: React + nginx]&lt;br&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;SPA без интеграции с Keycloak: относительные URL (/auth/login, /auth/session, /reports), credentials: include.&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="260" x="540" y="180" as="geometry" />
        </mxCell>
        <mxCell id="auth" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=12" value="&lt;b&gt;bionicpro-auth&lt;/b&gt;&lt;br&gt;[Container: Python + FastAPI]&lt;br&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;OAuth 2.0 Code + PKCE (S256) с Keycloak, хранение access/refresh-токенов на сервере (refresh зашифрован), сессии HttpOnly/Secure/SameSite=Lax, ротация session id (в т.ч. в /auth/validate для auth_request), автообновление токенов, /auth/validate выдаёт X-Access-Token для шлюза.&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="300" x="1161" y="460" as="geometry" />
        </mxCell>
        <mxCell id="sessionstore" parent="1" style="shape=cylinder3;size=12;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=12" value="&lt;b&gt;Хранилище сессий и токенов&lt;/b&gt;&lt;br&gt;[Компонент: память сервиса]&lt;br&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;session_id → access_token (TTL ≤ 2 мин), refresh_token зашифрован (Fernet). TTL сессии &gt; TTL токена.&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="260" x="1181" y="850" as="geometry" />
        </mxCell>
        <mxCell id="keycloak" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#ffffff;fontSize=12" value="&lt;b&gt;Keycloak 21.1&lt;/b&gt;&lt;br&gt;[Container: IdP + брокер идентичности]&lt;br&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;realm reports-realm. PKCE S256, access_token_lifespan ≤ 2 мин, refresh token, MFA (обязательный OTP), User Federation LDAP, Identity Brokering (Яндекс ID с экраном согласия).&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="300" x="1730" y="465.5" as="geometry" />
        </mxCell>
        <mxCell id="keycloakdb" parent="1" style="shape=cylinder3;size=12;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#ffffff;fontSize=12" value="&lt;b&gt;БД Keycloak&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;пользователи, креденшелы, сессии, клиенты.&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="200" x="1780" y="845" as="geometry" />
        </mxCell>
        <mxCell id="openldap" parent="1" style="shape=cylinder3;size=12;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#438DD5;strokeColor=#3C6499;fontColor=#ffffff;fontSize=12" value="&lt;b&gt;OpenLDAP&lt;/b&gt;&lt;br&gt;[Container: каталог представительства]&lt;br&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;ou=People / ou=Groups (dc=example,dc=com). Группы user, prothetic_user маппятся в роли realm.&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="280" x="1740" y="160" as="geometry" />
        </mxCell>
        <mxCell id="yandex" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6C6477;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=12;dashed=1" value="&lt;b&gt;Яндекс ID&lt;/b&gt;&lt;br&gt;[Внешний IdP, OAuth 2.0]&lt;br&gt;&lt;font color=&quot;#cccccc&quot;&gt;login.yandex.ru. Профиль пользователя (имя, логин, email) запрашивается после согласия и сохраняется в БД.&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="280" x="2260" y="485" as="geometry" />
        </mxCell>
        <mxCell id="reportsapi" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=12" value="&lt;b&gt;bionicpro-api (reports-api)&lt;/b&gt;&lt;br&gt;[Container: API отчётов]&lt;br&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;GET /reports, валидация Bearer access_token по JWKS (aud=reports-api); получает токен от шлюза, а не из браузера.&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="260" x="540" y="840" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="person" style="rounded=0;orthogonalLoop=1;html=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=none;" target="gateway" value="HTTP(S), единый origin :8085;&lt;div&gt;&amp;nbsp;session cookie first-party&lt;/div&gt;&lt;div&gt;&amp;nbsp;(HttpOnly, Secure, SameSite);&lt;/div&gt;&lt;div&gt;&amp;nbsp;CORS не требуется&lt;/div&gt;">
          <mxGeometry relative="1" x="-0.2308" y="43" as="geometry">
            <mxPoint y="1" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="gateway" style="rounded=0;orthogonalLoop=1;html=1;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=1" target="frontend" value="/ → раздача SPA-статики; fetch относительных URL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="gateway" style="rounded=0;orthogonalLoop=1;html=1;fontSize=11;exitX=1;exitY=0.25;entryX=0;entryY=0.25;exitDx=0;exitDy=0;entryDx=0;entryDy=0;labelBackgroundColor=none;" target="auth" value="/auth/* → login (PKCE-редирект),&amp;nbsp;&lt;div&gt;callback (обмен code, Set-Cookie session_id),&amp;nbsp;&lt;div&gt;session, me, logout&lt;/div&gt;&lt;/div&gt;">
          <mxGeometry relative="1" x="-0.0227" y="37" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e3b" edge="1" parent="1" source="gateway" style="rounded=0;orthogonalLoop=1;html=1;fontSize=11;dashed=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;fillColor=none;labelBackgroundColor=none;" target="auth" value="auth_request /_auth → /auth/validate:&lt;div&gt;&amp;nbsp;200 + X-Access-Token +&amp;nbsp;&lt;/div&gt;&lt;div&gt;ротированная cookie (пробрасывается в ответ)&lt;/div&gt;">
          <mxGeometry relative="1" x="0.0233" y="-29" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="gateway" style="rounded=0;orthogonalLoop=1;html=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;labelBackgroundColor=none;" target="reportsapi" value="/reports → proxy c Authorization:&lt;div&gt;&amp;nbsp;Bearer access_token (из auth_request);&amp;nbsp;&lt;/div&gt;&lt;div&gt;cookie на API не передаётся&lt;/div&gt;">
          <mxGeometry relative="1" x="0.0028" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="auth" style="rounded=0;orthogonalLoop=1;html=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=none;" target="keycloak" value="OAuth 2.0 Authorization Code&lt;div&gt;&amp;nbsp;+ PKCE (S256);&amp;nbsp;&lt;/div&gt;">
          <mxGeometry relative="1" x="0.0004" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="auth" style="rounded=0;orthogonalLoop=1;html=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0" target="sessionstore" value="чтение/запись сессии,&amp;nbsp;&lt;div&gt;ротация&lt;/div&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="keycloak" style="rounded=0;orthogonalLoop=1;html=1;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;" target="openldap" value="LDAP bind;&amp;nbsp;&lt;div&gt;маппинг групп → роли realm&lt;/div&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="keycloak" style="rounded=0;orthogonalLoop=1;html=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="yandex" value="Identity Brokering OAuth 2.0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="keycloak" style="rounded=0;orthogonalLoop=1;html=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;" target="keycloakdb" value="users, credentials, sessions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
